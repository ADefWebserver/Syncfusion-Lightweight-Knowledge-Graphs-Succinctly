@page "/graphchat"
@rendermode InteractiveServer
@using Microsoft.Extensions.AI
@using Syncfusion.Blazor.InteractiveChat
@using SyncfusionHelpDesk.Components.Shared
@using SyncfusionHelpDesk.Services.AI.GraphTools
@using SyncfusionHelpDesk.Services.Graph
@using Markdig
@using ChatMessage = Microsoft.Extensions.AI.ChatMessage
@inject IChatClient ChatClient
@inject IGraphChatTools GraphTools
@inject IGraphWriteTools GraphWriteTools

<PageTitle>Graph Assistant</PageTitle>

<AuthorizeView>
    <Authorized>
        <h1>Graph Assistant</h1>
        <p class="text-muted">
            Ask questions about the help-desk knowledge graph. Any change you
            request is previewed for your approval before it is applied.
        </p>

        <div class="graph-chat-container">
            <SfAIAssistView PromptSuggestions="@_promptSuggestions"
                            PromptRequested="@PromptRequestedAsync">
            </SfAIAssistView>
        </div>

        <MutationApproval Visible="_approvalVisible"
                          VisibleChanged="@(v => _approvalVisible = v)"
                          Preview="_pendingPreview"
                          OnApprove="ApproveAsync"
                          OnReject="RejectAsync" />
    </Authorized>
    <NotAuthorized>
        <h1>Graph Assistant</h1>
        <p>Please <a href="Account/Login">sign in</a> to use the Graph Assistant.</p>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static readonly MarkdownPipeline _markdownPipeline =
        new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();

    private readonly List<string> _promptSuggestions = new()
    {
        "How many tickets has this email opened?",
        "List the open tickets.",
        "Show graph statistics.",
    };

    private readonly List<ChatMessage> _history = new()
    {
        new ChatMessage(ChatRole.System, GraphSystemPrompt.Text),
    };

    private bool _approvalVisible;
    private MutationPreview? _pendingPreview;

    private async Task PromptRequestedAsync(AssistViewPromptRequestedEventArgs args)
    {
        // Clear any stale proposal so it cannot be approved by accident.
        GraphWriteTools.ClearPending();

        var responseText = await GetAssistantResponseAsync(args.Prompt);
        args.Response = Markdown.ToHtml(responseText, _markdownPipeline);

        if (GraphWriteTools.Pending is { } pending)
        {
            _pendingPreview = pending.Preview;
            _approvalVisible = true;
        }
    }

    private async Task ApproveAsync()
    {
        _approvalVisible = false;
        await GraphWriteTools.ApplyPendingAsync();
        _pendingPreview = null;
    }

    private void RejectAsync()
    {
        _approvalVisible = false;
        _pendingPreview = null;
        GraphWriteTools.ClearPending();
    }

    private async Task<string> GetAssistantResponseAsync(string prompt)
    {
        _history.Add(new ChatMessage(ChatRole.User, prompt));

        try
        {
            var options = new ChatOptions
            {
                Tools = GraphToolRegistration.CreateTools(GraphTools),
            };

            var response = await ChatClient.GetResponseAsync(_history, options);

            _history.AddRange(response.Messages);

            return string.IsNullOrWhiteSpace(response.Text)
                ? "I could not find an answer to that question in the graph."
                : response.Text;
        }
        catch (Exception ex)
        {
            return "The request failed. Please verify the OpenAI API key in the " +
                   $"\"AI\" configuration section. Details: {ex.Message}";
        }
    }
}
